# 小麒麟全球转租通 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置 (必需)
# ============================================
DATABASE_URL=mysql://username:password@localhost:3306/xiaoqilin

# ============================================
# 服务器配置
# ============================================
# 服务器端口 (默认: 3000)
PORT=3000

# 运行环境 (development | production)
NODE_ENV=development

# ============================================
# Cloudflare配置 (可选 - 用于Cloudflare Pages部署)
# ============================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Workers API URL (部署Workers后填写)
VITE_API_URL=https://xiaoqilin-api.YOUR_SUBDOMAIN.workers.dev

# ============================================
# Mapbox地图配置 (必需)
# ============================================
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiMXZlYjYiLCJhIjoiY21sNHhhdWFwMDBsODNncHU5Z3RtNGZsciJ9.Yrl4KD7r-C5IiTZwf89e9g

# ============================================
# 其他配置 (可选)
# ============================================
# 会话密钥 (用于用户会话加密)
SESSION_SECRET=your_random_secret_key_here

# CORS允许的域名
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# ============================================
# 第三方服务配置 (可选)
# ============================================
# 如果需要集成其他服务，在此添加配置
# 例如：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password

# ============================================
# 开发环境配置
# ============================================
# 是否启用调试模式
DEBUG=false

# 日志级别 (error | warn | info | debug)
LOG_LEVEL=info
