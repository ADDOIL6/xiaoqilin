// 国家地区数据结构 - 完全参考租房君的筛选逻辑

export interface City {
  name: string;
  nameEn: string;
}

export interface State {
  name: string;
  nameEn: string;
  cities: City[];
}

export interface Country {
  code: string;
  name: string;
  nameEn: string;
  hotCities?: City[]; // 热门城市（英国、美国、加拿大有）
  cities?: City[]; // 平铺城市列表（英国、澳洲、新加坡使用）
  states?: State[]; // 州/省分组（美国、加拿大使用）
}

